{
	"name": "pi-auto-mode",
	"version": "1.0.0",
	"description": "Pi extension: every bash command is judged by an OpenRouter model before it runs; unsafe or off-task commands are blocked.",
	"type": "module",
	"keywords": [
		"pi-package",
		"pi",
		"pi-extension",
		"pi-coding-agent",
		"safety",
		"openrouter"
	],
	"license": "MIT",
	"pi": {
		"extensions": [
			"./extensions/pi-auto-mode.ts"
		]
	},
	"scripts": {
		"typecheck": "tsc -p .",
		"check": "biome check .",
		"format": "biome format --write .",
		"prepare": "husky >/dev/null 2>&1 || true"
	},
	"dependencies": {
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.2",
		"@earendil-works/pi-coding-agent": "1.4.0",
		"@types/node": "26.6.5",
		"husky": "9.1.7",
		"typescript": "7.0.2"
	}
}
