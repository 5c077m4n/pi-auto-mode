{
  "name": "pi-auto-mode",
  "version": "1.0.0",
  "description": "Pi extension: every bash command is judged by an OpenRouter model before it runs; unsafe or off-task commands are blocked.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "pi-coding-agent",
    "safety",
    "openrouter"
  ],
  "license": "MIT",
  "pi": {
    "extensions": [
      "./extensions/pi-auto-mode.ts"
    ]
  },
  "dependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/node": "^24"
  },
  "scripts": {
    "typecheck": "tsc -p ."
  }
}
