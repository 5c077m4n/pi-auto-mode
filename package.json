{
	"name": "pi-auto-mode",
	"version": "1.0.0",
	"description": "Pi extension: every bash command is judged by an OpenRouter model before it runs; unsafe or off-task commands are blocked.",
	"type": "module",
	"keywords": [
		"pi-package",
		"pi",
		"pi-extension",
		"pi-coding-agent",
		"safety",
		"openrouter"
	],
	"license": "MIT",
	"pi": {
		"extensions": [
			"./extensions/pi-auto-mode.ts"
		]
	},
	"scripts": {
		"typecheck": "tsc -p .",
		"check": "biome check .",
		"format": "biome format --write .",
		"prepare": "husky"
	},
	"dependencies": {
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2",
		"@types/node": "^24",
		"husky": "^9",
		"typescript": "^5"
	}
}
